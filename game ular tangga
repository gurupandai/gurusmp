<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Detektif Makna: Edisi Ular Tangga — Bahasa Indonesia Kelas 9</title>
  <!-- Google Fonts: Fredoka & Nunito -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@600;700;800&display=swap" rel="stylesheet" />
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['Fredoka', 'sans-serif'],
            body: ['Nunito', 'sans-serif'],
          },
          colors: {
            detective: {
              cream: '#FFFBEB',
              amber: '#F59E0B',
              navy: '#1E293B',
              indigo: '#3730A3',
              teal: '#0D9488',
              coral: '#F43F5E',
            }
          }
        }
      }
    };
  </script>
  <style>
    /* Gaya Kustom Tema Detektif Literasi */
    body {
      font-family: 'Nunito', sans-serif;
      background-color: #FEF9E7;
      background-image:
        radial-gradient(#FDE68A 1.5px, transparent 1.5px),
        radial-gradient(#FED7AA 1.5px, #FEF9E7 1.5px);
      background-size: 36px 36px;
      background-position: 0 0, 18px 18px;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, .font-fredoka {
      font-family: 'Fredoka', sans-serif;
    }

    /* Animasi Kocok Dadu */
    @keyframes diceShake {
      0% { transform: rotate(0deg) scale(1); }
      20% { transform: rotate(-18deg) scale(1.12) translateY(-6px); }
      40% { transform: rotate(16deg) scale(1.15) translateY(-10px); }
      60% { transform: rotate(-14deg) scale(1.1) translateY(-4px); }
      80% { transform: rotate(12deg) scale(1.06) translateY(-2px); }
      100% { transform: rotate(0deg) scale(1); }
    }

    .animate-dice-roll {
      animation: diceShake 0.55s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }

    /* Animasi Denyut Kotak Spesial Bintang */
    @keyframes starPulse {
      0%, 100% { transform: scale(1) rotate(0deg); }
      50% { transform: scale(1.18) rotate(8deg); }
    }

    .animate-star-badge {
      animation: starPulse 2s ease-in-out infinite;
    }

    /* Animasi Lompatan Pion */
    @keyframes pawnHop {
      0%, 100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-14px) scale(1.14); }
    }

    .pawn-hopping {
      animation: pawnHop 0.28s ease-out;
    }

    /* Animasi Masuk Modal */
    @keyframes modalPop {
      0% { opacity: 0; transform: scale(0.9) translateY(14px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }

    .animate-modal-pop {
      animation: modalPop 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Tombol 3D Ramah Anak */
    .btn-3d {
      transition: transform 0.12s ease, box-shadow 0.12s ease, filter 0.15s ease;
    }
    .btn-3d:active:not(:disabled) {
      transform: translateY(3px);
    }

    /* Scrollbar Rapi */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #FEF3C7;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb {
      background: #F59E0B;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col selection:bg-amber-300 selection:text-slate-900">

  <!-- ==================== TOP NAVIGATION BAR ==================== -->
  <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b-2 border-amber-200 shadow-sm">
    <div class="max-w-6xl mx-auto px-3 sm:px-6 py-2.5 flex items-center justify-between gap-2">
      <!-- Brand / Logo -->
      <button onclick="navigateTo('start')" class="flex items-center gap-2.5 text-left group focus:outline-none">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center shadow-md border-2 border-amber-200 group-hover:scale-105 transition-transform">
          <!-- Ikon Kaca Pembesar Detektif SVG -->
          <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
            <path d="M9 11h4M11 9v4" stroke-width="2"></path>
          </svg>
        </div>
        <div>
          <h1 class="font-fredoka text-base sm:text-xl font-bold text-slate-800 leading-tight">
            Detektif <span class="text-amber-600">Makna</span>
          </h1>
          <p class="text-[11px] sm:text-xs font-bold text-indigo-700 tracking-wide">
            Edisi Ular Tangga • Bahasa Indonesia SMP IX
          </p>
        </div>
      </button>

      <!-- Action Controls -->
      <div class="flex items-center gap-1.5 sm:gap-2.5">
        <button id="btn-sound-toggle" onclick="toggleSound()" title="Atur Efek Suara"
          class="p-2.5 sm:px-3.5 sm:py-2 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-900 font-bold text-xs sm:text-sm flex items-center gap-1.5 border border-amber-300 transition">
          <span id="sound-icon">🔊</span>
          <span id="sound-label" class="hidden sm:inline">Suara Aktif</span>
        </button>

        <button onclick="openRulesModal()"
          class="p-2.5 sm:px-3.5 sm:py-2 rounded-xl bg-sky-100 hover:bg-sky-200 text-sky-900 font-bold text-xs sm:text-sm flex items-center gap-1.5 border border-sky-300 transition">
          <span>📖</span>
          <span class="hidden sm:inline">Panduan</span>
        </button>

        <button onclick="navigateTo('leaderboard')"
          class="p-2.5 sm:px-3.5 sm:py-2 rounded-xl bg-indigo-100 hover:bg-indigo-200 text-indigo-900 font-bold text-xs sm:text-sm flex items-center gap-1.5 border border-indigo-300 transition">
          <span>🏆</span>
          <span class="hidden sm:inline">Peringkat</span>
        </button>

        <button onclick="openSpreadsheetModal()"
          class="p-2.5 sm:px-3.5 sm:py-2 rounded-xl bg-emerald-100 hover:bg-emerald-200 text-emerald-900 font-bold text-xs sm:text-sm flex items-center gap-1.5 border border-emerald-300 transition">
          <span>📊</span>
          <span class="hidden sm:inline">Spreadsheet</span>
          <span id="gs-nav-dot" class="w-2 h-2 rounded-full bg-amber-500"></span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== TOAST NOTIFICATION BANNER ==================== -->
  <div id="toast-container" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 pointer-events-none w-[92%] max-w-md flex flex-col items-center gap-2"></div>

  <!-- ==================== MAIN CONTENT CONTAINER ==================== -->
  <main class="flex-1 max-w-6xl w-full mx-auto px-3 sm:px-6 py-4 sm:py-6">

    <!-- ============================================================ -->
    <!-- 1. HALAMAN AWAL (START SCREEN)                               -->
    <!-- ============================================================ -->
    <section id="start-screen" class="max-w-2xl mx-auto">
      <div class="bg-white rounded-3xl shadow-xl border-4 border-amber-300 overflow-hidden">
        <!-- Hero Banner -->
        <div class="bg-gradient-to-r from-indigo-700 via-indigo-600 to-teal-600 p-6 sm:p-8 text-white text-center relative overflow-hidden">
          <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold mb-3 border border-white/30">
            <span>🕵️‍♂️</span> Misi Literasi SMP Kelas 9: Makna Tersurat &amp; Tersirat
          </div>
          <h2 class="font-fredoka text-2xl sm:text-4xl font-bold tracking-tight drop-shadow-sm">
            Detektif Makna:<br class="sm:hidden" /> Edisi Ular Tangga
          </h2>
          <p class="mt-2 text-indigo-100 text-sm sm:text-base max-w-lg mx-auto">
            Lempar dadu, selidiki kutipan teks, naiki tangga petunjuk, dan hindari jebakan ular untuk menjadi Detektif Bahasa terbaik!
          </p>
        </div>

        <!-- Form Input Tim & Pemain -->
        <form id="start-form" onsubmit="handleStartGame(event)" class="p-5 sm:p-8 space-y-5">
          <!-- Identitas Kelas & Sekolah -->
          <div class="bg-amber-50/90 p-4 rounded-2xl border-2 border-amber-200">
            <label for="input-team" class="block font-fredoka text-sm sm:text-base font-semibold text-amber-900 mb-1.5">
              🏫 Kelas &amp; Sekolah (Identitas Tim)
            </label>
            <input
              type="text"
              id="input-team"
              maxlength="40"
              placeholder="Contoh: Kelas 9A - SMPN 1 Nusantara"
              class="w-full px-4 py-3 rounded-xl bg-white border-2 border-amber-300 focus:border-indigo-500 focus:outline-none font-bold text-slate-800 placeholder:font-normal placeholder:text-slate-400 transition"
            />
          </div>

          <!-- Input Pemain 1 & Pemain 2 -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Pemain 1 (Merah) -->
            <div class="bg-rose-50 p-4 rounded-2xl border-2 border-rose-200">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 rounded-full bg-rose-600 text-white text-xs font-bold flex items-center justify-center shadow">P1</span>
                <label for="input-p1" class="font-fredoka text-base font-semibold text-rose-900">
                  Pemain 1 (Merah)
                </label>
              </div>
              <input
                type="text"
                id="input-p1"
                maxlength="24"
                placeholder="Nama Detektif Merah..."
                class="w-full px-4 py-3 rounded-xl bg-white border-2 border-rose-300 focus:border-rose-600 focus:outline-none font-bold text-slate-800 placeholder:font-normal placeholder:text-slate-400 transition"
              />
            </div>

            <!-- Pemain 2 (Biru) -->
            <div class="bg-sky-50 p-4 rounded-2xl border-2 border-sky-200">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 rounded-full bg-sky-600 text-white text-xs font-bold flex items-center justify-center shadow">P2</span>
                <label for="input-p2" class="font-fredoka text-base font-semibold text-sky-900">
                  Pemain 2 (Biru)
                </label>
              </div>
              <input
                type="text"
                id="input-p2"
                maxlength="24"
                placeholder="Nama Detektif Biru..."
                class="w-full px-4 py-3 rounded-xl bg-white border-2 border-sky-300 focus:border-sky-600 focus:outline-none font-bold text-slate-800 placeholder:font-normal placeholder:text-slate-400 transition"
              />
            </div>
          </div>

          <!-- Ringkasan Aturan Singkat -->
          <div class="grid grid-cols-3 gap-2.5 text-center text-xs sm:text-sm">
            <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-3">
              <div class="text-xl mb-1">🪜⭐</div>
              <p class="font-bold text-emerald-900">Tangga Petunjuk</p>
              <p class="text-[11px] text-emerald-700">Jawab benar = naik!</p>
            </div>
            <div class="bg-rose-50 border border-rose-200 rounded-2xl p-3">
              <div class="text-xl mb-1">🐍⭐</div>
              <p class="font-bold text-rose-900">Jebakan Ular</p>
              <p class="text-[11px] text-rose-700">Terkecoh = turun!</p>
            </div>
            <div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-3">
              <div class="text-xl mb-1">🏁25</div>
              <p class="font-bold text-indigo-900">Petak Finis</p>
              <p class="text-[11px] text-indigo-700">Tercepat jadi juara!</p>
            </div>
          </div>

          <!-- Tombol Aksi Utama -->
          <div class="flex flex-col sm:flex-row gap-3 pt-1">
            <button type="submit"
              class="btn-3d flex-1 py-4 px-6 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-white font-fredoka text-lg sm:text-xl font-bold shadow-[0_5px_0_#B45309] flex items-center justify-center gap-2">
              <span>🔍</span> Mulai Investigasi!
            </button>

            <button type="button" onclick="navigateTo('leaderboard')"
              class="btn-3d py-4 px-6 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-fredoka text-base sm:text-lg font-bold shadow-[0_5px_0_#312E81] flex items-center justify-center gap-2">
              <span>🏆</span> Leaderboard
            </button>
          </div>
        </form>

        <!-- Kredit Kreator -->
        <div class="bg-amber-50/90 border-t-2 border-amber-200 px-5 py-3 text-center">
          <p class="text-xs sm:text-sm font-bold text-slate-600 flex items-center justify-center gap-1.5">
            <span>✍️</span> Kreator: <span class="font-fredoka text-indigo-800 font-bold">Syahriatul Qudsiah</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. HALAMAN PERMAINAN (GAME SCREEN)                           -->
    <!-- ============================================================ -->
    <section id="game-screen" class="hidden">
      <!-- Bar Identitas Tim & Tombol Keluar -->
      <div class="bg-white/95 rounded-2xl p-3 sm:px-5 sm:py-3.5 mb-4 border-2 border-amber-300 shadow-sm flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2.5">
          <span class="text-xl">🏫</span>
          <div>
            <p class="text-[11px] font-bold uppercase tracking-wider text-amber-700">Tim Investigasi</p>
            <h2 id="display-team-name" class="font-fredoka text-sm sm:text-lg font-bold text-slate-800">
              Kelas 9A - SMPN 1 Nusantara
            </h2>
          </div>
        </div>

        <button onclick="openQuitConfirmModal()"
          class="px-3.5 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs sm:text-sm transition">
          🚪 Keluar Misi
        </button>
      </div>

      <!-- Layout Utama Papan (Kiri) & Kontrol Dadu (Kanan) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        <!-- Kolom Papan Ular Tangga 5x5 -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-3 sm:p-5 shadow-xl border-4 border-amber-300">
          <div id="board-wrapper" class="relative w-full aspect-square max-w-[540px] mx-auto select-none">
            <!-- Grid 5x5 Zig-Zag -->
            <div id="board-grid" class="grid grid-cols-5 grid-rows-5 gap-1.5 sm:gap-2.5 w-full h-full"></div>

            <!-- Layer SVG Tangga & Ular -->
            <svg id="board-svg-overlay" class="absolute inset-0 w-full h-full pointer-events-none z-10"></svg>

            <!-- Pion Pemain 1 (Merah) -->
            <div id="pawn-p1"
              class="absolute z-20 -translate-x-1/2 -translate-y-1/2 transition-all duration-300 pointer-events-none flex flex-col items-center">
              <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-gradient-to-br from-rose-500 to-red-700 border-2 sm:border-[3px] border-white shadow-lg flex items-center justify-center text-white font-fredoka font-bold text-xs sm:text-sm">
                P1
              </div>
            </div>

            <!-- Pion Pemain 2 (Biru) -->
            <div id="pawn-p2"
              class="absolute z-20 -translate-x-1/2 -translate-y-1/2 transition-all duration-300 pointer-events-none flex flex-col items-center">
              <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-gradient-to-br from-sky-500 to-blue-700 border-2 sm:border-[3px] border-white shadow-lg flex items-center justify-center text-white font-fredoka font-bold text-xs sm:text-sm">
                P2
              </div>
            </div>
          </div>

          <!-- Legenda Papan -->
          <div class="mt-3 pt-3 border-t border-amber-100 flex flex-wrap items-center justify-center gap-3 text-xs font-bold text-slate-600">
            <span class="inline-flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-rose-600 inline-block"></span> Pemain 1 (Merah)</span>
            <span class="inline-flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-sky-600 inline-block"></span> Pemain 2 (Biru)</span>
            <span class="inline-flex items-center gap-1">⭐🪜 Tangga (Jawab Benar = Naik)</span>
            <span class="inline-flex items-center gap-1">⭐🐍 Ular (Terkecoh = Turun)</span>
          </div>
        </div>

        <!-- Kolom Panel Giliran, Dadu & Log -->
        <div class="lg:col-span-5 space-y-4">
          <!-- Kartu Status Pemain 1 & 2 -->
          <div class="grid grid-cols-2 gap-3">
            <div id="card-p1" class="rounded-2xl p-3.5 bg-white border-4 border-rose-500 shadow-md transition-all">
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="px-2 py-0.5 rounded-full bg-rose-600 text-white text-[10px] font-extrabold">P1 MERAH</span>
                <span id="badge-turn-p1" class="px-2 py-0.5 rounded-full bg-amber-300 text-slate-900 text-[10px] font-extrabold animate-pulse">GILIRAN</span>
              </div>
              <p id="name-p1" class="font-fredoka font-bold text-sm sm:text-base text-slate-800 truncate">Detektif Merah</p>
              <div class="mt-2 flex items-center justify-between text-xs font-bold text-slate-600 bg-rose-50 px-2.5 py-1.5 rounded-xl">
                <span>Petak: <strong id="pos-p1" class="text-rose-700 text-sm">1</strong>/25</span>
                <span>🎲 <strong id="rolls-p1">0</strong>x</span>
              </div>
            </div>

            <div id="card-p2" class="rounded-2xl p-3.5 bg-white/80 border-2 border-slate-200 shadow-sm opacity-75 transition-all">
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="px-2 py-0.5 rounded-full bg-sky-600 text-white text-[10px] font-extrabold">P2 BIRU</span>
                <span id="badge-turn-p2" class="hidden px-2 py-0.5 rounded-full bg-amber-300 text-slate-900 text-[10px] font-extrabold animate-pulse">GILIRAN</span>
              </div>
              <p id="name-p2" class="font-fredoka font-bold text-sm sm:text-base text-slate-800 truncate">Detektif Biru</p>
              <div class="mt-2 flex items-center justify-between text-xs font-bold text-slate-600 bg-sky-50 px-2.5 py-1.5 rounded-xl">
                <span>Petak: <strong id="pos-p2" class="text-sky-700 text-sm">1</strong>/25</span>
                <span>🎲 <strong id="rolls-p2">0</strong>x</span>
              </div>
            </div>
          </div>

          <!-- Kotak Dadu Interaktif -->
          <div class="bg-white rounded-3xl p-5 shadow-xl border-4 border-indigo-200 text-center">
            <div id="turn-banner" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-rose-100 text-rose-800 font-fredoka font-semibold text-sm sm:text-base mb-4">
              <span>🔴</span>
              <span>Giliran: <strong id="turn-player-name">Detektif Merah</strong></span>
            </div>

            <!-- Visual Dadu SVG -->
            <div class="flex justify-center my-2">
              <div id="dice-box" onclick="rollDice()"
                class="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl bg-gradient-to-br from-white to-amber-50 border-4 border-slate-800 shadow-[0_8px_0_#1E293B] flex items-center justify-center cursor-pointer hover:scale-105 transition-transform">
                <svg id="dice-svg" viewBox="0 0 100 100" class="w-16 h-16 sm:w-20 sm:h-20"></svg>
              </div>
            </div>

            <p id="dice-status-text" class="text-xs sm:text-sm font-bold text-slate-600 mt-3 mb-4">
              Klik tombol atau tekan Spasi untuk melempar dadu!
            </p>

            <button id="btn-roll-dice" onclick="rollDice()"
              class="btn-3d w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 disabled:opacity-50 disabled:cursor-not-allowed text-white font-fredoka text-lg font-bold shadow-[0_5px_0_#312E81] flex items-center justify-center gap-2">
              <span>🎲</span> Kocok Dadu!
            </button>
          </div>

          <!-- Catatan Investigasi (Log Permainan) -->
          <div class="bg-white rounded-2xl p-4 shadow-md border-2 border-amber-200">
            <h3 class="font-fredoka font-bold text-sm text-slate-700 mb-2 flex items-center gap-1.5">
              <span>🗒️</span> Catatan Langkah Detektif
            </h3>
            <ul id="game-log-list" class="space-y-1.5 max-h-36 overflow-y-auto text-xs font-semibold text-slate-700 pr-1"></ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. HALAMAN LEADERBOARD (PAPAN PERINGKAT)                     -->
    <!-- ============================================================ -->
    <section id="leaderboard-screen" class="hidden max-w-3xl mx-auto">
      <div class="bg-white rounded-3xl shadow-xl border-4 border-amber-300 overflow-hidden">
        <!-- Header Leaderboard -->
        <div class="bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 p-6 text-white text-center">
          <div class="text-4xl mb-1">🏆</div>
          <h2 class="font-fredoka text-2xl sm:text-3xl font-bold">Papan Peringkat Detektif Makna</h2>
          <p class="text-amber-100 text-xs sm:text-sm mt-1">
            Peringkat tim terbaik berdasarkan efisiensi lemparan dadu &amp; ketepatan analisis teks
          </p>
        </div>

        <div class="p-5 sm:p-7">
          <!-- Podium 3 Besar -->
          <div id="podium-container" class="grid grid-cols-3 gap-2 sm:gap-4 items-end mb-7 pt-4">
            <!-- Dirender secara dinamis dari localStorage -->
          </div>

          <!-- Daftar Skor Lengkap -->
          <div class="bg-slate-50 rounded-2xl border-2 border-slate-200 overflow-hidden">
            <div class="px-4 py-3 bg-slate-100 border-b border-slate-200 flex items-center justify-between">
              <h3 class="font-fredoka font-bold text-sm sm:text-base text-slate-700">Daftar Rekor Detektif</h3>
              <span id="leaderboard-count" class="text-xs font-bold text-slate-500">0 Rekor</span>
            </div>
            <div id="leaderboard-list" class="divide-y divide-slate-200 max-h-72 overflow-y-auto">
              <!-- Dirender secara dinamis -->
            </div>
          </div>

          <!-- Tombol Navigasi Leaderboard -->
          <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
