    function addGameLog(text) {
      const logList = document.getElementById('game-log-list');
      if (!logList) return;
      const li = document.createElement('li');
      li.className = 'bg-amber-50/80 border border-amber-200/80 rounded-xl px-2.5 py-1.5';
