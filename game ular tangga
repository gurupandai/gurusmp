  <script>
    /**
     * =========================================================================
     * 1. MODUL EFEK SUARA WEB AUDIO API (TANPA URL EKSTERNAL)
     * =========================================================================
     */
    class SoundFX {
      constructor() {
        this.ctx = null;
        this.enabled = true;
      }

      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) {
            this.ctx = new AudioCtx();
          }
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playTone(freq, type = 'sine', duration = 0.15, startTimeOffset = 0, volume = 0.18) {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;

        const now = this.ctx.currentTime + startTimeOffset;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.type = type;
        osc.frequency.setValueAtTime(freq, now);

        gain.gain.setValueAtTime(0.001, now);
        gain.gain.exponentialRampToValueAtTime(volume, now + 0.015);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start(now);
        osc.stop(now + duration + 0.02);
      }

      // Efek suara kocok dadu
      playDiceRoll() {
        if (!this.enabled) return;
        const freqs = [240, 320, 280, 390, 310, 440];
        freqs.forEach((f, idx) => {
          this.playTone(f, 'triangle', 0.06, idx * 0.075, 0.15);
        });
      }

      // Efek suara langkah pion per petak
      playStep(stepIndex = 0) {
        const baseFreq = 420 + (stepIndex % 5) * 45;
        this.playTone(baseFreq, 'sine', 0.11, 0, 0.16);
      }

      // Efek suara mendarat di kotak spesial (⭐)
      playSpecialTile() {
        this.playTone(587.33, 'triangle', 0.18, 0, 0.2);     // D5
        this.playTone(880.00, 'triangle', 0.28, 0.14, 0.22); // A5
      }

      // Efek suara jawaban benar
      playCorrect() {
        this.playTone(523.25, 'triangle', 0.14, 0, 0.2);     // C5
        this.playTone(659.25, 'triangle', 0.14, 0.1, 0.2);   // E5
        this.playTone(783.99, 'triangle', 0.16, 0.2, 0.22);  // G5
        this.playTone(1046.5, 'sine', 0.32, 0.3, 0.24);      // C6
      }

      // Efek suara jawaban salah
      playWrong() {
        this.playTone(311.13, 'sawtooth', 0.2, 0, 0.13);     // Eb4
        this.playTone(233.08, 'sawtooth', 0.32, 0.18, 0.13); // Bb3
      }

      // Efek suara naik tangga
      playLadderClimb() {
        const notes = [392, 440, 493.88, 523.25, 659.25, 783.99];
        notes.forEach((n, i) => this.playTone(n, 'sine', 0.12, i * 0.065, 0.18));
      }

      // Efek suara turun ular
      playSnakeSlide() {
        const notes = [523.25, 466.16, 415.30, 349.23, 293.66, 220.00];
        notes.forEach((n, i) => this.playTone(n, 'triangle', 0.13, i * 0.07, 0.17));
      }

      // Efek suara menang permainan
      playWin() {
        const melody = [
          { f: 523.25, t: 0.00, d: 0.15 },
          { f: 523.25, t: 0.16, d: 0.15 },
          { f: 523.25, t: 0.32, d: 0.15 },
          { f: 659.25, t: 0.48, d: 0.28 },
          { f: 587.33, t: 0.78, d: 0.18 },
          { f: 659.25, t: 0.98, d: 0.18 },
          { f: 783.99, t: 1.18, d: 0.45 }
        ];
        melody.forEach(m => this.playTone(m.f, 'triangle', m.d, m.t, 0.24));
      }
    }

    const sfx = new SoundFX();

    function toggleSound() {
      sfx.enabled = !sfx.enabled;
      const iconEl = document.getElementById('sound-icon');
      const labelEl = document.getElementById('sound-label');
      if (sfx.enabled) {
        iconEl.textContent = '🔊';
        labelEl.textContent = 'Suara Aktif';
        sfx.playStep(2);
      } else {
        iconEl.textContent = '🔇';
        labelEl.textContent = 'Suara Bisu';
      }
    }

