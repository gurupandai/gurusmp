        btn.className = 'w-full text-left p-3.5 rounded-2xl border-2 border-slate-200 bg-slate-50 hover:bg-indigo-50 hover:border-indigo-400 font-bold text-xs sm:text-sm text-slate-800 transition flex items-start gap-3';
        btn.innerHTML = `
          <span class="w-7 h-7 rounded-xl bg-indigo-600 text-white font-fredoka font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">${letters[idx]}</span>
          <span class="leading-snug">${escapeHtml(optText)}</span>
        `;
        optionsContainer.appendChild(btn);
      });

      const feedbackBox = document.getElementById('quiz-feedback-box');
      feedbackBox.classList.add('hidden');
      modal.classList.remove('hidden');
    }

    function selectQuizOption(selectedIdx) {
      const pending = gameState.pendingQuiz;
      if (!pending) return;

      const { questionObj, type, fromTile, toTile } = pending;
      const isCorrect = selectedIdx === questionObj.correctIndex;
      pending.isCorrect = isCorrect;

      // Kunci semua tombol pilihan dan beri penanda warna
      questionObj.options.forEach((_, idx) => {
        const btn = document.getElementById(`quiz-opt-btn-${idx}`);
        if (!btn) return;
        btn.disabled = true;
        if (idx === questionObj.correctIndex) {
          btn.className = 'w-full text-left p-3.5 rounded-2xl border-2 border-emerald-500 bg-emerald-100 font-bold text-xs sm:text-sm text-emerald-950 flex items-start gap-3';
        } else if (idx === selectedIdx && !isCorrect) {
          btn.className = 'w-full text-left p-3.5 rounded-2xl border-2 border-rose-500 bg-rose-100 font-bold text-xs sm:text-sm text-rose-950 flex items-start gap-3';
        } else {
          btn.className = 'w-full text-left p-3.5 rounded-2xl border-2 border-slate-200 bg-slate-100 opacity-60 font-bold text-xs sm:text-sm text-slate-600 flex items-start gap-3';
        }
      });

      const player = gameState.players[gameState.currentTurn];
      const feedbackBox = document.getElementById('quiz-feedback-box');
      const feedbackIcon = document.getElementById('quiz-feedback-icon');
      const feedbackTitle = document.getElementById('quiz-feedback-title');
      const feedbackExp = document.getElementById('quiz-feedback-explanation');
      const continueBtn = document.getElementById('btn-quiz-continue');

      if (isCorrect) {
        sfx.playCorrect();
        player.correct += 1;
        feedbackBox.className = 'rounded-2xl p-4 border-2 bg-emerald-50 border-emerald-400 text-emerald-950 transition-all';
        feedbackIcon.textContent = '🎉';
        feedbackTitle.textContent = type === 'ladder'
          ? `Analisis Tepat! Kamu berhak naik tangga ke Petak ${toTile}!`
          : `Analisis Tepat! Kamu lolos dari ular dan aman di Petak ${fromTile}!`;
        continueBtn.textContent = type === 'ladder' ? `Naik ke Petak ${toTile} 🪜` : 'Lanjutkan Giliran ➡️';
      } else {
        sfx.playWrong();
        feedbackBox.className = 'rounded-2xl p-4 border-2 bg-rose-50 border-rose-400 text-rose-950 transition-all';
        feedbackIcon.textContent = '🧐';
        feedbackTitle.textContent = type === 'ladder'
          ? `Kurang Tepat! Kamu belum berhasil naik tangga dan tetap di Petak ${fromTile}.`
          : `Terkecoh Makna! Ular menarikmu turun ke Petak ${toTile}.`;
        continueBtn.textContent = type === 'snake' ? `Turun ke Petak ${toTile} 🐍` : 'Lanjutkan Giliran ➡️';
      }

      feedbackExp.textContent = `Pembahasan: ${questionObj.explanation}`;
      feedbackBox.classList.remove('hidden');
    }

    function finalizeQuizOutcome() {
      const pending = gameState.pendingQuiz;
      document.getElementById('quiz-modal').classList.add('hidden');

      if (!pending) {
        switchTurn();
        return;
      }

      const pIdx = gameState.currentTurn;
      const player = gameState.players[pIdx];
      const { type, fromTile, toTile, isCorrect } = pending;
      gameState.pendingQuiz = null;

      if (type === 'ladder' && isCorrect) {
        sfx.playLadderClimb();
        player.pos = toTile;
        document.getElementById(`pos-p${player.id}`).textContent = String(toTile);
        updatePawnPositions(pIdx);
        addGameLog(`🪜 ${player.name} memecahkan petunjuk dan naik tangga ke Petak ${toTile}!`);
      } else if (type === 'ladder' && !isCorrect) {
        addGameLog(`❌ ${player.name} gagal memecahkan petunjuk tangga di Petak ${fromTile}.`);
      } else if (type === 'snake' && isCorrect) {
        addGameLog(`🛡️ ${player.name} menjawab tepat dan selamat dari ular di Petak ${fromTile}!`);
      } else if (type === 'snake' && !isCorrect) {
        sfx.playSnakeSlide();
        player.pos = toTile;
        document.getElementById(`pos-p${player.id}`).textContent = String(toTile);
        updatePawnPositions(pIdx);
        addGameLog(`🐍 ${player.name} terkecoh makna dan turun ke Petak ${toTile}!`);
      }

      if (player.pos >= TOTAL_TILES) {
        handleGameOver(pIdx);
      } else {
        switchTurn();
      }
    }

    /**
     * =========================================================================
     * 10. HALAMAN GAME OVER, SKOR & LEADERBOARD (LOCALSTORAGE)
     * =========================================================================
     */
    function calculatePlayerScore(player, isWinner) {
      const base = (player.pos * 40) + (player.correct * 150) - (player.rolls * 15) + (isWinner ? 300 : 0);
      return Math.max(100, base);
    }

    function handleGameOver(winnerIdx) {
      gameState.isBusy = true;
      sfx.playWin();

      const winner = gameState.players[winnerIdx];
      const loserIdx = winnerIdx === 0 ? 1 : 0;
      const loser = gameState.players[loserIdx];

      const winnerScore = calculatePlayerScore(winner, true);
      const loserScore = calculatePlayerScore(loser, false);
      const totalCombinedRolls = winner.rolls + loser.rolls;

      // Simpan pemenang ke Leaderboard lokal
      saveScoreToLocalLeaderboard({
        teamName: gameState.teamName,
        winnerName: winner.name,
        pawnColor: winner.color,
        rolls: winner.rolls,
        correct: winner.correct,
        score: winnerScore,
        date: new Date().toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })
      });

      // Siapkan data kedua siswa untuk dikirim ke Google Spreadsheet
      lastCompletedMatchRecords = gameState.players.map((p, idx) => ({
        teamName: gameState.teamName,
        studentName: p.name,
        pawn: `Pemain ${p.id} (${p.color})`,
        finalPos: p.pos,
        rolls: p.rolls,
        correct: p.correct,
        score: idx === winnerIdx ? winnerScore : loserScore,
        status: idx === winnerIdx ? 'Menang (Juara)' : 'Selesai'
      }));

      document.getElementById('winner-name-display').textContent = `🏆 ${winner.name} Menang!`;
      document.getElementById('winner-team-display').textContent = gameState.teamName;
      document.getElementById('stat-winner-rolls').textContent = `${winner.rolls} Kali`;
      document.getElementById('stat-winner-score').textContent = `${winnerScore} Poin`;
      document.getElementById('stat-winner-correct').textContent = `${winner.correct} Kasus`;
      document.getElementById('stat-total-rolls').textContent = `${totalCombinedRolls} Kali`;

      document.getElementById('gameover-modal').classList.remove('hidden');
      syncMatchToGoogleSheets(lastCompletedMatchRecords);
    }

    function saveScoreToLocalLeaderboard(entry) {
      try {
        const existing = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        existing.push(entry);
        existing.sort((a, b) => (b.score - a.score) || (a.rolls - b.rolls));
        localStorage.setItem(STORAGE_KEY, JSON.stringify(existing.slice(0, 30)));
      } catch (e) {
        // Abaikan jika penyimpanan lokal dibatasi browser
      }
    }

    function renderLeaderboard() {
      const podiumEl = document.getElementById('podium-container');
      const listEl = document.getElementById('leaderboard-list');
      const countEl = document.getElementById('leaderboard-count');
      if (!podiumEl || !listEl) return;

      let records = [];
      try {
        records = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      } catch (e) {
        records = [];
      }

      countEl.textContent = `${records.length} Rekor`;

      if (records.length === 0) {
        podiumEl.innerHTML = `
          <div class="col-span-3 text-center py-6 bg-amber-50 rounded-2xl border-2 border-dashed border-amber-300">
            <p class="text-2xl mb-1">🕵️‍♀️</p>
            <p class="font-fredoka font-bold text-slate-700">Belum ada rekor detektif tercatat.</p>
            <p class="text-xs font-semibold text-slate-500 mt-0.5">Selesaikan satu permainan untuk mengisi podium juara!</p>
          </div>
        `;
        listEl.innerHTML = `
          <div class="p-6 text-center text-xs sm:text-sm font-bold text-slate-400">
            Data peringkat masih kosong.
          </div>
        `;
        return;
      }

      // Podium 3 Besar (urutan tampilan: Juara 2 di kiri, Juara 1 di tengah, Juara 3 di kanan)
      const podiumOrder = [
        { rank: 2, idx: 1, medal: '🥈', height: 'h-24 sm:h-28', bg: 'from-slate-200 to-slate-300 border-slate-400' },
        { rank: 1, idx: 0, medal: '🥇', height: 'h-32 sm:h-36', bg: 'from-amber-200 via-yellow-300 to-amber-400 border-amber-500' },
        { rank: 3, idx: 2, medal: '🥉', height: 'h-20 sm:h-24', bg: 'from-orange-200 to-amber-300 border-orange-400' }
      ];

      podiumEl.innerHTML = podiumOrder.map(slot => {
        const item = records[slot.idx];
        if (!item) {
          return `
            <div class="flex flex-col items-center">
              <div class="text-xs font-bold text-slate-400 mb-1">-</div>
              <div class="w-full ${slot.height} rounded-t-2xl bg-slate-100 border-2 border-dashed border-slate-300 flex items-center justify-center font-fredoka font-bold text-slate-400">
                #${slot.rank}
              </div>
            </div>
          `;
        }
        return `
          <div class="flex flex-col items-center text-center">
            <div class="text-2xl sm:text-3xl mb-0.5">${slot.medal}</div>
            <p class="font-fredoka font-bold text-xs sm:text-sm text-slate-800 truncate w-full px-1">${escapeHtml(item.winnerName)}</p>
            <p class="text-[10px] font-bold text-indigo-700 truncate w-full px-1 mb-1.5">${escapeHtml(item.teamName)}</p>
            <div class="w-full ${slot.height} rounded-t-2xl bg-gradient-to-b ${slot.bg} border-2 flex flex-col items-center justify-center p-1 shadow">
              <span class="font-fredoka font-bold text-sm sm:text-base text-slate-900">${item.score}</span>
              <span class="text-[10px] font-extrabold text-slate-700">🎲 ${item.rolls}x</span>
            </div>
          </div>
        `;
      }).join('');

      listEl.innerHTML = records.map((item, i) => `
        <div class="px-4 py-3 flex items-center justify-between gap-3 bg-white hover:bg-amber-50/60 transition">
          <div class="flex items-center gap-3 min-w-0">
            <span class="w-7 h-7 rounded-full ${i < 3 ? 'bg-amber-400 text-slate-950' : 'bg-slate-200 text-slate-700'} font-fredoka font-bold text-xs flex items-center justify-center shrink-0">
              ${i + 1}
            </span>
            <div class="min-w-0">
              <p class="font-fredoka font-bold text-sm text-slate-800 truncate">${escapeHtml(item.winnerName)}</p>
              <p class="text-[11px] font-semibold text-slate-500 truncate">${escapeHtml(item.teamName)} • ${escapeHtml(item.date || '')}</p>
            </div>
          </div>
          <div class="text-right shrink-0">
            <p class="font-fredoka font-bold text-sm text-indigo-700">${item.score} Poin</p>
            <p class="text-[11px] font-bold text-slate-500">🎲 ${item.rolls} lemparan</p>
          </div>
        </div>
      `).join('');
    }

    function handleResetLeaderboard() {
      const btn = document.getElementById('btn-reset-leaderboard');
      if (!btn) return;

      if (btn.dataset.confirmed !== 'true') {
        btn.dataset.confirmed = 'true';
        btn.textContent = '⚠️ Klik Sekali Lagi untuk Hapus';
        btn.className = 'py-2.5 px-4 rounded-xl bg-rose-600 text-white border border-rose-700 font-bold text-xs sm:text-sm transition';
        clearTimeout(resetConfirmTimer);
        resetConfirmTimer = setTimeout(() => {
          btn.dataset.confirmed = 'false';
          btn.textContent = '🗑️ Hapus Riwayat Skor';
          btn.className = 'py-2.5 px-4 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs sm:text-sm transition';
        }, 3500);
        return;
      }

      clearTimeout(resetConfirmTimer);
      btn.dataset.confirmed = 'false';
      btn.textContent = '🗑️ Hapus Riwayat Skor';
      btn.className = 'py-2.5 px-4 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs sm:text-sm transition';

      localStorage.removeItem(STORAGE_KEY);
      renderLeaderboard();
      showToast('🗑️ Riwayat papan peringkat lokal telah dibersihkan.', 'info');
    }

    function closeGameOverAndViewLeaderboard() {
      document.getElementById('gameover-modal').classList.add('hidden');
      gameState.isBusy = false;
      navigateTo('leaderboard');
    }

    function rematchSamePlayers() {
      document.getElementById('gameover-modal').classList.add('hidden');
      gameState.players[0].pos = 1;
      gameState.players[0].rolls = 0;
      gameState.players[0].correct = 0;
      gameState.players[1].pos = 1;
      gameState.players[1].rolls = 0;
      gameState.players[1].correct = 0;
      gameState.currentTurn = 0;
      gameState.isBusy = false;
      gameState.pendingQuiz = null;

      document.getElementById('pos-p1').textContent = '1';
      document.getElementById('pos-p2').textContent = '1';
      document.getElementById('rolls-p1').textContent = '0';
      document.getElementById('rolls-p2').textContent = '0';

      const logList = document.getElementById('game-log-list');
      logList.innerHTML = '';
      addGameLog(`🔄 Babak ulang dimulai! ${gameState.players[0].name} vs ${gameState.players[1].name}.`);

      updateTurnUI();
      renderDiceFace(1);
      updatePawnPositions();
    }

    function closeGameOverAndGoStart() {
      document.getElementById('gameover-modal').classList.add('hidden');
      gameState.isBusy = false;
      navigateTo('start');
    }

    /**
     * =========================================================================
     * 11. INTEGRASI GOOGLE SPREADSHEET (APPS SCRIPT WEB APP)
     * =========================================================================
     */
    function getGoogleScriptUrl() {
      try {
        const saved = (localStorage.getItem(GS_URL_STORAGE_KEY) || '').trim();
        return saved || DEFAULT_GOOGLE_SCRIPT_URL;
      } catch (e) {
        return DEFAULT_GOOGLE_SCRIPT_URL;
      }
    }

    function updateSpreadsheetIndicator() {
      const dot = document.getElementById('gs-nav-dot');
      if (!dot) return;
      if (getGoogleScriptUrl()) {
        dot.className = 'w-2 h-2 rounded-full bg-emerald-500';
      } else {
        dot.className = 'w-2 h-2 rounded-full bg-amber-500';
      }
    }

    function openSpreadsheetModal() {
      const input = document.getElementById('input-gs-url');
      if (input) {
        input.value = getGoogleScriptUrl();
      }
      document.getElementById('spreadsheet-modal').classList.remove('hidden');
    }

    function closeSpreadsheetModal() {
      document.getElementById('spreadsheet-modal').classList.add('hidden');
    }

    function saveGoogleScriptUrl() {
      const input = document.getElementById('input-gs-url');
      const rawUrl = input ? input.value.trim() : '';

      if (rawUrl) {
        try {
          new URL(rawUrl);
        } catch (e) {
          showToast('⚠️ Format URL Web App tidak valid.', 'warn');
          return;
        }
        localStorage.setItem(GS_URL_STORAGE_KEY, rawUrl);
      } else {
        localStorage.removeItem(GS_URL_STORAGE_KEY);
      }

      updateSpreadsheetIndicator();
      closeSpreadsheetModal();

      if (rawUrl) {
        showToast('✅ URL Google Spreadsheet berhasil disimpan!', 'success');
        if (lastCompletedMatchRecords.length > 0 && !document.getElementById('gameover-modal').classList.contains('hidden')) {
          syncMatchToGoogleSheets(lastCompletedMatchRecords);
        }
      } else {
        showToast('ℹ️ Menggunakan URL Google Spreadsheet bawaan aplikasi.', 'info');
      }
    }

    async function testGoogleScriptConnection() {
      const url = document.getElementById('input-gs-url').value.trim() || getGoogleScriptUrl();
      const btn = document.getElementById('btn-test-gs');
      if (!url) {
        showToast('⚠️ Masukkan URL Web App terlebih dahulu.', 'warn');
        return;
      }

      btn.disabled = true;
      btn.textContent = '⏳ Menguji...';

      try {
        const response = await fetch(url);
        const result = await response.json();
        if (result && result.status === 'active') {
          showToast('✅ Koneksi berhasil! Google Spreadsheet siap menerima nilai siswa.', 'success');
        } else {
          showToast('✅ Endpoint merespons! Siap digunakan untuk mengirim data.', 'success');
        }
      } catch (err) {
        showToast('⚠️ Pastikan deployment Apps Script diatur ke akses "Siapa saja (Anyone)".', 'warn');
      } finally {
        btn.disabled = false;
        btn.textContent = '🔌 Tes Koneksi';
      }
    }

    async function syncMatchToGoogleSheets(records) {
      const statusBox = document.getElementById('gs-sync-status');
      const statusText = document.getElementById('gs-sync-text');
      const retryBtn = document.getElementById('btn-retry-sync');
      const scriptUrl = getGoogleScriptUrl();

      if (!scriptUrl) {
        statusBox.className = 'rounded-2xl p-3 border-2 bg-amber-50 border-amber-200 text-xs font-bold text-amber-900 flex items-center justify-between gap-2 text-left';
        statusText.innerHTML = '📊 Spreadsheet belum terhubung. <button type="button" onclick="openSpreadsheetModal()" class="underline text-indigo-700 font-extrabold">Atur URL sekarang</button>';
        retryBtn.classList.add('hidden');
        return;
      }

      statusBox.className = 'rounded-2xl p-3 border-2 bg-sky-50 border-sky-200 text-xs font-bold text-sky-900 flex items-center justify-between gap-2 text-left';
      statusText.textContent = '⏳ Mengirim data nilai kedua siswa ke Google Spreadsheet...';
      retryBtn.classList.add('hidden');

      try {
        // Menggunakan text/plain agar Google Apps Script tidak terkena preflight CORS OPTIONS
        await fetch(scriptUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: {
            'Content-Type': 'text/plain;charset=utf-8'
          },
          body: JSON.stringify({
            action: 'saveMatch',
            records: records
          })
        });

        statusBox.className = 'rounded-2xl p-3 border-2 bg-emerald-50 border-emerald-300 text-xs font-bold text-emerald-900 flex items-center justify-between gap-2 text-left';
        statusText.textContent = '✅ Nilai Pemain 1 & Pemain 2 berhasil dikirim ke Google Spreadsheet!';
        retryBtn.classList.remove('hidden');
      } catch (error) {
        statusBox.className = 'rounded-2xl p-3 border-2 bg-rose-50 border-rose-300 text-xs font-bold text-rose-900 flex items-center justify-between gap-2 text-left';
        statusText.textContent = '⚠️ Gagal mengirim data ke Spreadsheet. Periksa koneksi internet.';
        retryBtn.classList.remove('hidden');
      }
    }

    function retrySyncToGoogleSheets() {
      if (lastCompletedMatchRecords.length > 0) {
        syncMatchToGoogleSheets(lastCompletedMatchRecords);
      }
    }

    function escapeHtml(text) {
      const str = String(text ?? '');
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    /**
     * =========================================================================
     * 12. INISIALISASI EVENT LISTENER & TAMPILAN AWAL
     * =========================================================================
     */
    window.addEventListener('resize', () => {
      const gameScreen = document.getElementById('game-screen');
      if (gameScreen && !gameScreen.classList.contains('hidden')) {
        renderBoardOverlay();
        updatePawnPositions();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.code === 'Space') {
        const activeTag = document.activeElement ? document.activeElement.tagName : '';
        if (activeTag === 'INPUT' || activeTag === 'TEXTAREA') return;

        const gameScreen = document.getElementById('game-screen');
        const anyModalOpen = ['quiz-modal', 'gameover-modal', 'rules-modal', 'quit-modal', 'spreadsheet-modal']
          .some(id => !document.getElementById(id).classList.contains('hidden'));

        if (gameScreen && !gameScreen.classList.contains('hidden') && !anyModalOpen) {
          e.preventDefault();
          rollDice();
        }
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      renderBoardGrid();
      renderDiceFace(1);
      updateSpreadsheetIndicator();
      renderLeaderboard();
    });
  </script>
