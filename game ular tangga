    function rollDice() {
      if (gameState.isBusy) return;
      const gameScreen = document.getElementById('game-screen');
      if (!gameScreen || gameScreen.classList.contains('hidden')) return;

      gameState.isBusy = true;
      const btnRoll = document.getElementById('btn-roll-dice');
      const diceBox = document.getElementById('dice-box');
      const statusText = document.getElementById('dice-status-text');

      btnRoll.disabled = true;
      statusText.textContent = '🎲 Mengocok dadu...';
      sfx.playDiceRoll();

      diceBox.classList.remove('animate-dice-roll');
      void diceBox.offsetWidth;
      diceBox.classList.add('animate-dice-roll');

      let ticks = 0;
      const animInterval = setInterval(() => {
        renderDiceFace(Math.floor(Math.random() * 6) + 1);
        ticks++;
        if (ticks >= 8) {
          clearInterval(animInterval);
          const finalValue = Math.floor(Math.random() * 6) + 1;
          renderDiceFace(finalValue);

          const pIdx = gameState.currentTurn;
          const player = gameState.players[pIdx];
          player.rolls += 1;
          document.getElementById(`rolls-p${player.id}`).textContent = String(player.rolls);

          statusText.textContent = `Hasil dadu: ${finalValue}! ${player.name} melangkah...`;
          addGameLog(`🎲 ${player.name} melempar dadu (${finalValue}).`);

          movePlayerSteps(pIdx, finalValue);
        }
      }, 65);
    }

    function movePlayerSteps(playerIdx, steps) {
      const player = gameState.players[playerIdx];
      let remaining = steps;

      const stepInterval = setInterval(() => {
        if (remaining <= 0 || player.pos >= TOTAL_TILES) {
          clearInterval(stepInterval);
          handleTileArrival(playerIdx);
          return;
        }

        player.pos += 1;
        remaining -= 1;
        document.getElementById(`pos-p${player.id}`).textContent = String(player.pos);
        updatePawnPositions(playerIdx);
        sfx.playStep(player.pos);
      }, 280);
    }

    function handleTileArrival(playerIdx) {
      const player = gameState.players[playerIdx];
      const tile = player.pos;

      if (tile >= TOTAL_TILES) {
        player.pos = TOTAL_TILES;
        document.getElementById(`pos-p${player.id}`).textContent = String(TOTAL_TILES);
        updatePawnPositions(playerIdx);
        addGameLog(`🏁 ${player.name} tiba di Petak 25 dan memenangkan investigasi!`);
        handleGameOver(playerIdx);
        return;
      }

      if (LADDERS[tile]) {
        sfx.playSpecialTile();
        addGameLog(`⭐ ${player.name} menemukan Tangga Petunjuk di Petak ${tile}!`);
        openQuizModal('ladder', tile, LADDERS[tile]);
        return;
      }

      if (SNAKES[tile]) {
        sfx.playSpecialTile();
        addGameLog(`⭐ ${player.name} terjebak Kepala Ular di Petak ${tile}!`);
        openQuizModal('snake', tile, SNAKES[tile]);
        return;
      }

      switchTurn();
    }

    function switchTurn() {
      gameState.currentTurn = gameState.currentTurn === 0 ? 1 : 0;
      gameState.isBusy = false;
      updateTurnUI();
      renderDiceFace(1);
    }

    /**
     * =========================================================================
     * 9. SISTEM KUIS INTERAKTIF KOTAK SPESIAL (⭐)
     * =========================================================================
     */
    function getNextQuestion() {
      let available = QUESTION_BANK.filter(q => !gameState.usedQuestionIds.includes(q.id));
      if (available.length === 0) {
        gameState.usedQuestionIds = [];
        available = [...QUESTION_BANK];
      }
      const chosen = available[Math.floor(Math.random() * available.length)];
      gameState.usedQuestionIds.push(chosen.id);
      return chosen;
    }

