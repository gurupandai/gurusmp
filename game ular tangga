    /**
     * =========================================================================
     * 7. PEMBUATAN PAPAN 5x5 ZIG-ZAG, SVG TANGGA/ULAR & POSISI PION
     * =========================================================================
     */
    function getTileGridCoords(tileNum) {
      const zeroIdx = Math.max(0, Math.min(TOTAL_TILES - 1, tileNum - 1));
      const rowFromBottom = Math.floor(zeroIdx / BOARD_SIZE);
      const gridRow = (BOARD_SIZE - 1) - rowFromBottom;
      const colInRow = zeroIdx % BOARD_SIZE;
      const gridCol = (rowFromBottom % 2 === 0) ? colInRow : ((BOARD_SIZE - 1) - colInRow);
      return { gridRow, gridCol };
    }

    function renderBoardGrid() {
      const grid = document.getElementById('board-grid');
      if (!grid) return;
      grid.innerHTML = '';

      // Bangun matrix 5x5 sesuai koordinat zig-zag
      const matrix = Array.from({ length: BOARD_SIZE }, () => Array(BOARD_SIZE).fill(1));
      for (let t = 1; t <= TOTAL_TILES; t++) {
        const { gridRow, gridCol } = getTileGridCoords(t);
        matrix[gridRow][gridCol] = t;
      }

      const tilePalettes = [
        'bg-amber-50 border-amber-200 text-slate-800',
        'bg-sky-50 border-sky-200 text-slate-800',
        'bg-emerald-50 border-emerald-200 text-slate-800',
        'bg-indigo-50 border-indigo-200 text-slate-800',
        'bg-orange-50 border-orange-200 text-slate-800'
      ];

      for (let r = 0; r < BOARD_SIZE; r++) {
        for (let c = 0; c < BOARD_SIZE; c++) {
          const tileNum = matrix[r][c];
          const isLadderBase = Boolean(LADDERS[tileNum]);
          const isSnakeHead = Boolean(SNAKES[tileNum]);
          const isStart = tileNum === 1;
          const isFinish = tileNum === TOTAL_TILES;

          let cardClass = tilePalettes[(r + c) % tilePalettes.length];
          let badgeHtml = '';

          if (isStart) {
            cardClass = 'bg-gradient-to-br from-teal-100 to-emerald-200 border-emerald-400 text-emerald-950';
            badgeHtml = '<span class="text-[10px] sm:text-xs font-extrabold text-emerald-800">MULAI</span>';
          } else if (isFinish) {
            cardClass = 'bg-gradient-to-br from-amber-200 via-yellow-200 to-orange-200 border-amber-500 text-amber-950';
            badgeHtml = '<span class="text-xs sm:text-sm">🏁</span>';
          } else if (isLadderBase) {
            cardClass = 'bg-gradient-to-br from-emerald-100 to-teal-100 border-emerald-400 text-emerald-950';
            badgeHtml = `<span class="animate-star-badge inline-block text-[11px] sm:text-xs font-extrabold text-emerald-800">⭐🪜${LADDERS[tileNum]}</span>`;
          } else if (isSnakeHead) {
            cardClass = 'bg-gradient-to-br from-rose-100 to-amber-100 border-rose-400 text-rose-950';
            badgeHtml = `<span class="animate-star-badge inline-block text-[11px] sm:text-xs font-extrabold text-rose-800">⭐🐍${SNAKES[tileNum]}</span>`;
          }

          const cell = document.createElement('div');
          cell.id = `tile-cell-${tileNum}`;
          cell.className = `relative rounded-xl sm:rounded-2xl border-2 ${cardClass} p-1 sm:p-1.5 flex flex-col justify-between shadow-sm overflow-hidden`;
          cell.innerHTML = `
            <div class="flex items-center justify-between leading-none">
              <span class="font-fredoka font-bold text-xs sm:text-base">${tileNum}</span>
              ${badgeHtml}
            </div>
          `;
          grid.appendChild(cell);
        }
      }
    }

    function getTileCenterPercent(tileNum) {
      const { gridRow, gridCol } = getTileGridCoords(tileNum);
      const step = 100 / BOARD_SIZE;
      return {
        x: (gridCol + 0.5) * step,
        y: (gridRow + 0.5) * step
      };
    }

    function renderBoardOverlay() {
      const svg = document.getElementById('board-svg-overlay');
      if (!svg) return;

      const width = svg.clientWidth || 500;
      const height = svg.clientHeight || 500;
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);

      let svgContent = '';

      // Gambar Tangga (Hijau / Emas)
      Object.entries(LADDERS).forEach(([fromStr, toNum]) => {
        const from = getTileCenterPercent(Number(fromStr));
        const to = getTileCenterPercent(Number(toNum));
        const x1 = (from.x / 100) * width;
        const y1 = (from.y / 100) * height;
        const x2 = (to.x / 100) * width;
        const y2 = (to.y / 100) * height;

        const dx = x2 - x1;
        const dy = y2 - y1;
        const len = Math.hypot(dx, dy) || 1;
        const nx = (-dy / len) * 7;
        const ny = (dx / len) * 7;

        svgContent += `
          <g opacity="0.82">
            <line x1="${x1 + nx}" y1="${y1 + ny}" x2="${x2 + nx}" y2="${y2 + ny}" stroke="#059669" stroke-width="4" stroke-linecap="round" />
            <line x1="${x1 - nx}" y1="${y1 - ny}" x2="${x2 - nx}" y2="${y2 - ny}" stroke="#059669" stroke-width="4" stroke-linecap="round" />
        `;

        const rungs = Math.max(3, Math.floor(len / 22));
        for (let i = 1; i < rungs; i++) {
          const t = i / rungs;
          const rx = x1 + dx * t;
          const ry = y1 + dy * t;
          svgContent += `
            <line x1="${rx + nx}" y1="${ry + ny}" x2="${rx - nx}" y2="${ry - ny}" stroke="#10B981" stroke-width="3" stroke-linecap="round" />
          `;
        }
        svgContent += `</g>`;
      });

      // Gambar Ular (Merah / Oranye melengkung)
      Object.entries(SNAKES).forEach(([fromStr, toNum]) => {
        const from = getTileCenterPercent(Number(fromStr));
        const to = getTileCenterPercent(Number(toNum));
        const x1 = (from.x / 100) * width;
        const y1 = (from.y / 100) * height;
        const x2 = (to.x / 100) * width;
        const y2 = (to.y / 100) * height;

        const midX = (x1 + x2) / 2;
        const midY = (y1 + y2) / 2;
        const offset = (x1 < x2 ? 22 : -22);
        const cx1 = (x1 + midX) / 2 + offset;
        const cy1 = (y1 + midY) / 2;
        const cx2 = (midX + x2) / 2 - offset;
        const cy2 = (midY + y2) / 2;

        svgContent += `
          <g opacity="0.82">
            <path d="M ${x1} ${y1} Q ${cx1} ${cy1}, ${midX} ${midY} T ${x2} ${y2}"
              fill="none" stroke="#E11D48" stroke-width="6" stroke-linecap="round" />
            <path d="M ${x1} ${y1} Q ${cx1} ${cy1}, ${midX} ${midY} T ${x2} ${y2}"
              fill="none" stroke="#FDE047" stroke-width="2" stroke-dasharray="5 6" stroke-linecap="round" />
            <circle cx="${x1}" cy="${y1}" r="6" fill="#BE123C" />
          </g>
        `;
      });

      svg.innerHTML = svgContent;
    }

    function updatePawnPositions(hoppingPlayerIdx = null) {
      const p1 = gameState.players[0];
      const p2 = gameState.players[1];
      const pawn1El = document.getElementById('pawn-p1');
      const pawn2El = document.getElementById('pawn-p2');
      if (!pawn1El || !pawn2El) return;

      const c1 = getTileCenterPercent(p1.pos);
      const c2 = getTileCenterPercent(p2.pos);
      const sameTile = p1.pos === p2.pos;

      pawn1El.style.left = `${c1.x + (sameTile ? -3.2 : 0)}%`;
      pawn1El.style.top = `${c1.y + (sameTile ? 2.5 : 1.5)}%`;

      pawn2El.style.left = `${c2.x + (sameTile ? 3.2 : 0)}%`;
      pawn2El.style.top = `${c2.y + (sameTile ? 2.5 : 1.5)}%`;

      if (hoppingPlayerIdx === 0) {
        pawn1El.classList.remove('pawn-hopping');
        void pawn1El.offsetWidth;
        pawn1El.classList.add('pawn-hopping');
      } else if (hoppingPlayerIdx === 1) {
        pawn2El.classList.remove('pawn-hopping');
        void pawn2El.offsetWidth;
        pawn2El.classList.add('pawn-hopping');
      }
    }

